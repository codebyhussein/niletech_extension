<odoo>
  <data>
    <record id="product_template_inherit_view_form" model="ir.ui.view">
      <field name="name">product.template.inherit.view.form</field>
      <field name="model">product.template</field>
      <field name="inherit_id" ref="product.product_template_form_view" />
      <field name="arch" type="xml">
        <xpath expr="//notebook" position="inside">
          <page string="Technical Information" name="technical_information">
            <group>
              <group>
                <field name="brand_name" />
                <field name="product_origin" />
                <field name="warranty_period" invisible="not is_under_warranty"/>
              </group>
              <group>
                <field name="is_under_warranty" />
                <field name="technical_description" />
              </group>
            </group>
          </page>
        </xpath>
      </field>
    </record>
  </data>
</odoo>