<?xml version="1.1" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="sale_order_inherit_view_form" model="ir.ui.view">
            <field name="name">sale.inherit.view.form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">


                <!-- Task 3: Delivery Information
                     Add custom delivery-related fields to the Sales Order form
                     to track customer PO details, expected delivery dates,
                     urgency, installation needs, and special delivery instructions.
                -->


                <xpath expr="//notebook" position="inside">
                    <page string="Delivery Information" name="delivery_information">
                        <group>
                            <group>
                                <field name="customer_po_number" />
                                <field name="expected_delivery_date" />
                                <field name="delivery_priority" />
                                <field name="requires_installation" />
                            </group>
                            <group>

                                <field name="delivery_notes" />
                            </group>
                        </group>
                    </page>
                </xpath>


            </field>
        </record>

    </data>
</odoo>